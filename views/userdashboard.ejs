<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Full Stack Cafe | Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #f43f5e; border-radius: 10px; }
        .menu-card { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .menu-card:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
        .filter-btn-active { background-color: #f43f5e !important; color: white !important; box-shadow: 0 10px 15px -3px rgba(244, 63, 94, 0.3); }
        .pagination-btn:disabled { opacity: 0.3; cursor: not-allowed; }
    </style>
</head>
<body class="bg-[#F8FAFC]">

<nav class="glass sticky top-0 z-50 border-b border-rose-100/50 px-6 py-4">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/dashboard?user=<%= encodeURIComponent(user || '') %>" class="font-black text-2xl text-rose-500 tracking-tighter">
            CAFE<span class="text-gray-900">STACK</span> 🍔
        </a>
        
        <div class="flex items-center gap-4">
            <% if (user) { %>
                <button onclick="showHistory()" class="hidden sm:flex items-center gap-2 font-bold text-gray-600 hover:text-rose-500 transition-colors">
                    📜 History
                </button>
                <div class="h-8 w-[1px] bg-gray-200 hidden sm:block"></div>
                <span class="font-bold text-gray-800">Hi, <%= user %></span>
            <% } %>

            <button onclick="toggleCart()" class="relative bg-gray-900 text-white p-3 rounded-2xl hover:scale-105 transition-transform active:scale-95">
                🛒 <span id="nav-cart-count" class="absolute -top-2 -right-2 bg-rose-500 text-[10px] font-bold px-2 py-1 rounded-full border-2 border-white">0</span>
            </button>

            <a href="/login" class="bg-rose-50 text-rose-600 px-5 py-2.5 rounded-2xl font-bold text-sm hover:bg-rose-100 transition-colors">Logout</a>
        </div>
    </div>
</nav>

<main class="max-w-7xl mx-auto p-6 md:p-12">
    <div class="mb-12">
        <p class="text-rose-500 font-extrabold tracking-widest uppercase text-sm mb-3">Premium Delivery</p>
        <h1 class="text-5xl md:text-7xl font-black text-gray-900 leading-[1.1]">
            Hungry? We’ve <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-orange-400">got you covered.</span>
        </h1>
    </div>

    <div class="flex gap-4 mb-12 overflow-x-auto pb-4 scrollbar-hide">
        <button id="filter-all" onclick="filterCategory('all', event)" class="filter-btn filter-btn-active whitespace-nowrap px-8 py-3.5 rounded-2xl font-bold bg-white text-gray-500 border border-gray-100 transition-all">All Items</button>
        <% if (locals.categories) { %>
            <% categories.forEach(cat => { %>
                <button onclick="filterCategory('<%= cat.name %>', event)" class="filter-btn whitespace-nowrap px-8 py-3.5 rounded-2xl font-bold bg-white text-gray-500 border border-gray-100 transition-all hover:border-rose-200">
                    <%= cat.name %>
                </button>
            <% }) %>
        <% } %>
    </div>

    <div id="items-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        </div>

    <div class="mt-16 flex flex-col items-center gap-4">
        <div class="flex items-center gap-2">
            <button id="prev-page" onclick="changePage(-1)" class="pagination-btn p-4 rounded-2xl bg-white border border-gray-100 text-gray-900 font-bold hover:bg-gray-50 transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            
            <div id="page-numbers" class="flex gap-2">
                </div>

            <button id="next-page" onclick="changePage(1)" class="pagination-btn p-4 rounded-2xl bg-white border border-gray-100 text-gray-900 font-bold hover:bg-gray-50 transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>
        <p id="page-info" class="text-sm font-bold text-gray-400 uppercase tracking-widest"></p>
    </div>
</main>

<div id="cart-modal" class="fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-[3rem] p-8 relative shadow-2xl">
        <button onclick="toggleCart()" class="absolute top-8 right-8 text-gray-400 hover:text-rose-500 font-bold text-xl">✕</button>
        <h2 class="text-3xl font-black mb-8 text-gray-900">Your Cart 🛒</h2>
        <div id="cart-items-list" class="space-y-4 max-h-[40vh] overflow-y-auto mb-8 pr-2 custom-scrollbar"></div>
        <div class="border-t border-gray-100 pt-6">
            <div class="flex justify-between items-center mb-6">
                <span class="text-gray-400 font-bold uppercase text-xs tracking-widest">Grand Total</span>
                <span id="cart-total" class="text-3xl font-black text-rose-500">$0.00</span>
            </div>
            <button onclick="checkout()" class="w-full bg-gray-900 text-white py-5 rounded-3xl font-bold text-lg hover:bg-rose-500 transition-all shadow-xl">
                Checkout Now
            </button>
        </div>
    </div>
</div>

<script>
    // --- Data Management ---
    const allItems = [
        <% if (locals.categories) { %>
            <% categories.forEach(category => { %>
                <% category.items.forEach(item => { %>
                    {
                        name: `<%= item.name.replace(/'/g, "\\'") %>`,
                        price: <%= item.price %>,
                        img: `<%= item.img || '' %>`,
                        category: `<%= category.name.toLowerCase() %>`
                    },
                <% }) %>
            <% }) %>
        <% } %>
    ];

    let userCart = JSON.parse(localStorage.getItem('cafeCart')) || [];
    const currentUser = "<%= user || '' %>";

    // --- Pagination State ---
    let currentPage = 1;
    const itemsPerPage = 6; 
    let filteredItems = [...allItems];

    function renderItems() {
        const grid = document.getElementById('items-grid');
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const paginatedItems = filteredItems.slice(start, end);

        grid.innerHTML = paginatedItems.map(item => `
            <div class="menu-card bg-white rounded-[2.5rem] p-5 border border-gray-100 flex flex-col justify-between">
                <div class="relative group h-56 w-full bg-gray-50 rounded-[2rem] overflow-hidden mb-6">
                    ${item.img ? 
                        `<img src="${item.img}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">` : 
                        `<div class="w-full h-full flex items-center justify-center text-5xl">🍕</div>`
                    }
                    <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-xs font-black text-rose-500 uppercase">
                        ${item.category}
                    </div>
                </div>
                <div class="px-2 pb-2">
                    <h3 class="text-xl font-bold text-gray-900 mb-1">${item.name}</h3>
                    <div class="flex justify-between items-center mt-4">
                        <span class="text-2xl font-black text-gray-900">$${item.price.toFixed(2)}</span>
                        <button onclick="addToCart('${item.name}', ${item.price})" 
                                class="bg-rose-500 text-white h-12 w-12 rounded-2xl flex items-center justify-center hover:bg-gray-900 transition-colors shadow-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        `).join('');

        updatePaginationControls();
    }

    function updatePaginationControls() {
        const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
        document.getElementById('prev-page').disabled = currentPage === 1;
        document.getElementById('next-page').disabled = currentPage === totalPages || totalPages === 0;
        document.getElementById('page-info').innerText = `Page ${currentPage} of ${totalPages || 1}`;
        
        // Dynamic Page Numbers
        const pageNumbers = document.getElementById('page-numbers');
        pageNumbers.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
            pageNumbers.innerHTML += `
                <button onclick="goToPage(${i})" class="w-12 h-12 rounded-2xl font-bold transition-all ${i === currentPage ? 'bg-rose-500 text-white shadow-lg shadow-rose-200' : 'bg-white text-gray-400 hover:text-rose-500'}">
                    ${i}
                </button>
            `;
        }
    }

    function changePage(step) {
        currentPage += step;
        renderItems();
        window.scrollTo({ top: 400, behavior: 'smooth' });
    }

    function goToPage(page) {
        currentPage = page;
        renderItems();
        window.scrollTo({ top: 400, behavior: 'smooth' });
    }

    function filterCategory(cat, e) {
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('filter-btn-active'));
        e.currentTarget.classList.add('filter-btn-active');
        
        filteredItems = cat === 'all' ? [...allItems] : allItems.filter(i => i.category === cat.toLowerCase());
        currentPage = 1;
        renderItems();
    }

    // --- Cart Logic ---
    function addToCart(name, price) {
        const item = userCart.find(i => i.name === name);
        if (item) item.quantity++;
        else userCart.push({ name, price, quantity: 1 });
        saveCart();
    }

    function saveCart() {
        localStorage.setItem('cafeCart', JSON.stringify(userCart));
        updateCartUI();
    }

    function updateCartUI() {
        const list = document.getElementById('cart-items-list');
        const count = document.getElementById('nav-cart-count');
        const totalDisp = document.getElementById('cart-total');
        count.innerText = userCart.reduce((a, b) => a + b.quantity, 0);
        let total = 0;
        list.innerHTML = userCart.length === 0 ? `<p class="text-center py-10 text-gray-400">Empty!</p>` : 
            userCart.map(item => {
                total += item.price * item.quantity;
                return `<div class="flex justify-between items-center bg-gray-50 p-4 rounded-2xl">
                    <div><p class="font-bold text-gray-900">${item.name}</p><p class="text-rose-500 font-bold">$${item.price.toFixed(2)}</p></div>
                    <span class="bg-white px-3 py-1 rounded-lg font-black text-xs">x${item.quantity}</span>
                </div>`;
            }).join('');
        totalDisp.innerText = `$${total.toFixed(2)}`;
    }

    function toggleCart() { document.getElementById('cart-modal').classList.toggle('hidden'); document.getElementById('cart-modal').classList.toggle('flex'); }
    function checkout() { window.location.href = `/order-summary?user=${encodeURIComponent(currentUser)}`; }
    function showHistory() { window.location.href = `/order-history?user=${encodeURIComponent(currentUser)}`; }

    window.onload = () => {
        renderItems();
        updateCartUI();
    };
</script>
</body>
</html>